# Path of the SQLite database (collector writes, web app reads)
AFTER_HOURS_DB=./data/after-hours.db

# Solana RPC the browser uses to send signed transactions (Helius free tier
# is fine; the public endpoint works for light use).
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Optional: our fee on every swap in basis points (25 = 0.25%) and the USDC
# token account (ATA, owned by your wallet, already created) that receives it.
# Taken on the USDC side of both buys and sells. Empty = no fee.
PLATFORM_FEE_BPS=
PLATFORM_FEE_ACCOUNT=

# Web Push (VAPID). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@after-hour.net
