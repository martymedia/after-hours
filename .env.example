# Path of the SQLite database (collector writes, web app reads)
AFTER_HOURS_DB=./data/after-hours.db

# Solana RPC used to send signed transactions (Helius free tier is fine)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Jupiter platform fee in basis points and the USDC token account
# that receives it. Leave empty to charge nothing.
PLATFORM_FEE_BPS=
PLATFORM_FEE_ACCOUNT=
