# Site block for the host's shared Caddy: drop it into that Caddy's conf.d/
# (it imports conf.d/*.caddy) and reload; the certificate is fetched on the
# first hit. The upstream is the web container's name on the shared network.
after-hour.net {
	encode gzip
	reverse_proxy after-hours-web-1:3000
}

www.after-hour.net {
	redir https://after-hour.net{uri} permanent
}
